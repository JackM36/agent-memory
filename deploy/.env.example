# Copy to .env and edit.

# The public DNS name pointing at this host (an A/AAAA record). Caddy gets its certificate for it.
AGENT_BRAIN_DOMAIN=brain.example.com

# Image to run: ghcr.io/<owner>/agent-brain-server:<version> (owner in lowercase). Releases publish one
# image per version; pin one here and change it to upgrade (see docs/deployment.md). "latest" follows every release.
AGENT_BRAIN_IMAGE_OWNER=jackm36
AGENT_BRAIN_VERSION=latest
