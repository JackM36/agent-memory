<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Authors>Jack Hadjicosti</Authors>
    <Product>Agent Brain</Product>
    <!-- Local builds are 0.0.0-dev; the release workflow passes -p:Version from semantic-release. -->
    <Version>0.0.0-dev</Version>
    <!-- Where brain update looks for releases (owner/repo on GitHub). CI passes the building repository. -->
    <AgentBrainRepository>JackM36/agent-memory</AgentBrainRepository>
  </PropertyGroup>
</Project>
